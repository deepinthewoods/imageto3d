+
+// Local patch (2026-11-18): the host conditioning path (pixal3d_cond_slat) reads each view's NAF map back
+// (1-4 GiB, channel-major) and samples it with 4 MB strides on the CPU -- 30-80 s per view under WSL. The
+// device-resident pixal3d_cond_slat_gpu (the WebGPU path) keeps it on the GPU and gathers only the active
+// voxels. PIXAL3D_COND_HOST=1 restores the host path for A/B.
+static std::vector<float> mv_slat_cond(const trellis::Model& dino, const trellis::Model& naf,
+                                       const std::vector<trellis::Pixal3dView>& views,
+                                       const trellis::Pixal3dSlatCondParams& prm,
+                                       const std::vector<std::array<int,3>>& coords, trellis::Pixal3dCond& c) {
+    const char* host = std::getenv("PIXAL3D_COND_HOST");
+    const double t0 = std::chrono::duration<double>(std::chrono::steady_clock::now().time_since_epoch()).count();
+    std::vector<float> proj_sp;
+    if (host && *host && *host != '0') {
+        c = trellis::pixal3d_cond_slat(dino, naf, views, prm);
+        proj_sp = trellis::pixal3d_gather_proj(c.proj, prm.R, c.d_proj, coords);
+    } else {
+        c = trellis::pixal3d_cond_slat_gpu(dino, naf, views, prm, nullptr, &coords);
+        proj_sp.swap(c.proj);
+    }
+    c.proj.clear(); c.proj.shrink_to_fit();
+    const double t1 = std::chrono::duration<double>(std::chrono::steady_clock::now().time_since_epoch()).count();
+    printf("      [cond] %s S=%d R=%d naf_T=%d tokens=%zu (%.1fs)\n", (host && *host && *host != '0') ? "host" : "gpu",
+           prm.S, prm.R, prm.naf_T, coords.size(), t1 - t0);
+    fflush(stdout);
+    return proj_sp;
+}
