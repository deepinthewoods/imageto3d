# Share the pipeline (code + docs) only. Everything else here is local working
# data: outputs, models, base views, concepts, experiments, the lowpoly study.
/*
!/.gitignore
!/README.md
!/AGENTS.md
!/CLAUDE.md
!/PROMPTING_GUIDE.md
!/TRIPO_HANDOFF.md
!/PIPELINE_V2_PLAN.md
!/tools/
# The shell/slot/layer prototype: its code and viewer pages were retired in pipeline v2 phase 6 (2026-11-25; the builder is tools/layers,
# the pages are the app's Mix / Aligned tabs; commit 82e6de1 has them). Only its README is tracked; its outputs (out/) stay local.
!/experiments/
/experiments/*
!/experiments/shell_slots_20261122/
/experiments/shell_slots_20261122/*
!/experiments/shell_slots_20261122/README.md

tools/lowpoly/lib/
node_modules/
__pycache__/
*.pyc
.codex_jobs/
# Hyper3D runner working data (jobs, native-monitor runs, per-module downloads)
tools/hyper3d_pipeline/jobs/
tools/hyper3d_pipeline/runs/
tools/hyper3d_pipeline/**/downloads/
tools/hyper3d_pipeline/probe/**/*.png
tools/hyper3d_pipeline/probe/**/x*/
# formy3d runner working data (probe screenshots/sample GLBs, per-module downloads)
tools/formy3d_pipeline/probe/**/*.png
tools/formy3d_pipeline/probe/**/*.glb
tools/formy3d_pipeline/**/downloads/
