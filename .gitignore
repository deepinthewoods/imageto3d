# Share the pipeline (code + docs) only. Everything else here is local working
# data: outputs, models, base views, concepts, experiments, the lowpoly study.
/*
!/.gitignore
!/README.md
!/AGENTS.md
!/CLAUDE.md
!/PROMPTING_GUIDE.md
!/TRIPO_HANDOFF.md
!/PIPELINE_V2_PLAN.md
!/tools/
# The shell/slot/layer prototype's processing code + viewer pages (user 2026-11-24: "I just wanna be able to go back to this");
# its generated outputs (out/ GLBs, scenes, renders) stay local
!/experiments/
/experiments/*
!/experiments/shell_slots_20261122/
/experiments/shell_slots_20261122/*
!/experiments/shell_slots_20261122/*.py
!/experiments/shell_slots_20261122/README.md
!/experiments/shell_slots_20261122/checks/
/experiments/shell_slots_20261122/checks/*
!/experiments/shell_slots_20261122/checks/*.py
!/experiments/shell_slots_20261122/checks/README.md
!/experiments/shell_slots_20261122/out/
/experiments/shell_slots_20261122/out/*
!/experiments/shell_slots_20261122/out/*.html
!/experiments/shell_slots_20261122/out/pieces/
/experiments/shell_slots_20261122/out/pieces/*
!/experiments/shell_slots_20261122/out/pieces/mix.html
!/experiments/shell_slots_20261122/out/layers/
/experiments/shell_slots_20261122/out/layers/*
!/experiments/shell_slots_20261122/out/layers/mix.html

tools/lowpoly/lib/
node_modules/
__pycache__/
*.pyc
.codex_jobs/
# Hyper3D runner working data (jobs, native-monitor runs, per-module downloads)
tools/hyper3d_pipeline/jobs/
tools/hyper3d_pipeline/runs/
tools/hyper3d_pipeline/**/downloads/
tools/hyper3d_pipeline/probe/**/*.png
tools/hyper3d_pipeline/probe/**/x*/
# formy3d runner working data (probe screenshots/sample GLBs, per-module downloads)
tools/formy3d_pipeline/probe/**/*.png
tools/formy3d_pipeline/probe/**/*.glb
tools/formy3d_pipeline/**/downloads/
