# Share the pipeline (code + docs) only. Everything else here is local working
# data: outputs, models, base views, concepts, experiments, the lowpoly study.
/*
!/.gitignore
!/README.md
!/AGENTS.md
!/CLAUDE.md
!/PROMPTING_GUIDE.md
!/TRIPO_HANDOFF.md
!/tools/

tools/lowpoly/lib/
node_modules/
__pycache__/
*.pyc
.codex_jobs/
# Hyper3D runner working data (jobs, native-monitor runs, per-module downloads)
tools/hyper3d_pipeline/jobs/
tools/hyper3d_pipeline/runs/
